{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/badmuriss/my-llm-kit/schemas/agent-graph-coordinator-capsule.json",
  "title": "Transcript-free coordinator capsule v1",
  "$ref": "#/$defs/versionedContract",
  "$defs": {
    "identifier": {"type": "string", "pattern": "^[A-Za-z0-9]+(?:[._-][A-Za-z0-9]+)*$"},
    "versionedContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "protocol_version", "workspace_scope", "change", "run_id", "driver", "capability_summary", "routing_overrides", "coordinator_generation", "resume_command", "control_runtime"],
      "properties": {
        "schema_version": {"const": 1},
        "protocol_version": {"const": 1},
        "workspace_scope": {"$ref": "https://github.com/badmuriss/my-llm-kit/schemas/agent-graph-placement.json#/$defs/workspaceScope"},
        "change": {"$ref": "#/$defs/identifier"},
        "run_id": {"$ref": "#/$defs/identifier"},
        "driver": {"enum": ["auto", "host", "orca"]},
        "capability_summary": {"$ref": "#/$defs/capabilitySummary"},
        "routing_overrides": {"$ref": "#/$defs/routingOverrides"},
        "coordinator_generation": {"type": "integer", "minimum": 1},
        "resume_command": {"type": "string", "minLength": 1, "maxLength": 8192},
        "control_runtime": {"$ref": "https://github.com/badmuriss/my-llm-kit/schemas/control-runtime-ref.json"}
      }
    },
    "capabilitySummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["agents", "models", "efforts", "placement_kinds", "execution_hosts"],
      "properties": {
        "agents": {"type": "array", "uniqueItems": true, "maxItems": 32, "items": {"type": "string", "minLength": 1}},
        "models": {"type": "array", "uniqueItems": true, "maxItems": 128, "items": {"type": "string", "minLength": 1}},
        "efforts": {"type": "array", "uniqueItems": true, "maxItems": 5, "items": {"enum": ["low", "medium", "high", "xhigh", "max"]}},
        "placement_kinds": {"type": "array", "uniqueItems": true, "maxItems": 3, "items": {"enum": ["current-workspace", "existing-workspace", "create-child-worktree"]}},
        "execution_hosts": {"type": "array", "uniqueItems": true, "maxItems": 64, "items": {"$ref": "https://github.com/badmuriss/my-llm-kit/schemas/agent-graph-placement.json#/$defs/opaqueHostId"}}
      }
    },
    "routingOverrides": {
      "type": "object",
      "additionalProperties": false,
      "required": ["agent", "model", "effort", "placement_request"],
      "properties": {
        "agent": {"type": ["string", "null"], "minLength": 1},
        "model": {"type": ["string", "null"], "minLength": 1},
        "effort": {"oneOf": [{"enum": ["low", "medium", "high", "xhigh", "max"]}, {"type": "null"}]},
        "placement_request": {"oneOf": [{"$ref": "https://github.com/badmuriss/my-llm-kit/schemas/agent-graph-placement.json#/$defs/placementRequest"}, {"type": "null"}]}
      }
    }
  }
}
