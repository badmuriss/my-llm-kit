{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/badmuriss/my-llm-kit/schemas/impl-learning-run.json",
  "title": "Shadow-mode impl learning record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "change",
    "observed_at",
    "state_ref",
    "state_sha256",
    "outcome",
    "facts",
    "candidates"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "run_id": {"$ref": "#/$defs/identifier"},
    "change": {"$ref": "#/$defs/identifier"},
    "observed_at": {"type": "string", "format": "date-time"},
    "state_ref": {"type": "string", "minLength": 1},
    "state_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "outcome": {"enum": ["pass", "partial", "blocked"]},
    "facts": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/fact"}
    },
    "candidates": {
      "type": "array",
      "items": {"$ref": "#/$defs/candidate"}
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9]+(?:[._-][A-Za-z0-9]+)*$"
    },
    "key": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
    },
    "fact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_id",
        "status",
        "check_command",
        "check_status",
        "check_attempts",
        "check_exit_code",
        "check_duration_ms",
        "check_total_duration_ms",
        "hypotheses",
        "evidence_refs",
        "visual_expectations"
      ],
      "properties": {
        "task_id": {"type": "string", "minLength": 1},
        "status": {"enum": ["pass", "fail", "unobserved", "blocked"]},
        "check_command": {"type": ["string", "null"], "minLength": 1},
        "check_status": {"enum": ["passed", "failed", "unobserved"]},
        "check_attempts": {"type": "integer", "minimum": 0},
        "check_exit_code": {"type": ["integer", "null"]},
        "check_duration_ms": {"type": ["integer", "null"], "minimum": 0},
        "check_total_duration_ms": {"type": "integer", "minimum": 0},
        "hypotheses": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "evidence_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "oneOf": [
              {"type": "string", "pattern": "^file:.+$"},
              {"type": "string", "pattern": "^commit:([0-9a-fA-F]{40}|[0-9a-fA-F]{64})$"}
            ]
          }
        },
        "visual_expectations": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "kind",
        "scopes",
        "statement",
        "stance",
        "origin",
        "evidence",
        "task_refs"
      ],
      "properties": {
        "key": {"$ref": "#/$defs/key"},
        "kind": {"enum": ["rule", "gate", "skill"]},
        "scopes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/key"}
        },
        "statement": {"type": "string", "minLength": 1},
        "stance": {"enum": ["support", "oppose"]},
        "origin": {"enum": ["check", "diff", "repair", "review"]},
        "evidence": {"type": "string", "minLength": 1},
        "task_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
