{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/badmuriss/my-llm-kit/schemas/agent-graph-context-capsule.json",
  "title": "Immutable bounded attempt context capsule",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "capsule_id",
    "task_id",
    "attempt_id",
    "workspace_scope",
    "budget",
    "usage",
    "items"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "capsule_id": {"$ref": "#/$defs/identifier"},
    "task_id": {"$ref": "#/$defs/identifier"},
    "attempt_id": {"$ref": "#/$defs/identifier"},
    "workspace_scope": {"$ref": "https://github.com/badmuriss/my-llm-kit/schemas/agent-graph-placement.json#/$defs/workspaceScope"},
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_items", "max_bytes", "max_tokens"],
      "properties": {
        "max_items": {"type": "integer", "minimum": 1, "maximum": 256},
        "max_bytes": {"type": "integer", "minimum": 1, "maximum": 1048576},
        "max_tokens": {"type": "integer", "minimum": 1, "maximum": 262144}
      }
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "item_count",
        "content_bytes",
        "content_tokens",
        "referenced_bytes",
        "omitted_items"
      ],
      "properties": {
        "item_count": {"type": "integer", "minimum": 1, "maximum": 256},
        "content_bytes": {"type": "integer", "minimum": 0, "maximum": 1048576},
        "content_tokens": {"type": "integer", "minimum": 0, "maximum": 262144},
        "referenced_bytes": {"type": "integer", "minimum": 0},
        "omitted_items": {"type": "integer", "minimum": 0}
      }
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {"$ref": "#/$defs/contextRef"}
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9]+(?:[._-][A-Za-z0-9]+)*$"
    },
    "contextRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "origin",
        "snapshot_path",
        "content_hash",
        "revision",
        "media_type",
        "title",
        "priority",
        "byte_count",
        "excerpt",
        "excerpt_bytes",
        "excerpt_tokens",
        "truncated"
      ],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "kind": {"enum": ["task", "user-note", "dependency", "decision", "source", "evidence"]},
        "origin": {"type": "string", "minLength": 1, "maxLength": 512},
        "snapshot_path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)[^\\u0000-\\u001f]+$"
        },
        "content_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "revision": {"type": "string", "minLength": 1, "maxLength": 256},
        "media_type": {"type": "string", "minLength": 1, "maxLength": 128},
        "title": {"type": "string", "minLength": 1, "maxLength": 512},
        "priority": {"type": "integer", "minimum": 1, "maximum": 5},
        "byte_count": {"type": "integer", "minimum": 0},
        "excerpt": {"type": ["string", "null"], "maxLength": 2048},
        "excerpt_bytes": {"type": "integer", "minimum": 0, "maximum": 2048},
        "excerpt_tokens": {"type": "integer", "minimum": 0, "maximum": 2048},
        "truncated": {"type": "boolean"}
      }
    },
    "noteSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "note_id",
        "revision",
        "content_hash",
        "media_type",
        "title",
        "snapshot_path",
        "byte_count"
      ],
      "properties": {
        "note_id": {"$ref": "#/$defs/identifier"},
        "revision": {"$ref": "#/$defs/identifier"},
        "content_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "media_type": {"const": "text/markdown"},
        "title": {"type": "string", "minLength": 1, "maxLength": 512},
        "snapshot_path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)[^\\u0000-\\u001f]+$"
        },
        "byte_count": {"type": "integer", "minimum": 1, "maximum": 1048576}
      }
    }
  }
}
