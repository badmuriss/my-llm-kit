{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/badmuriss/my-llm-kit/schemas/impl-learning-run.json",
  "title": "Impl learning run",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "change",
    "completed_at",
    "outcome",
    "tasks",
    "incidents",
    "learnings"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "run_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9]+(?:[._-][A-Za-z0-9]+)*$"
    },
    "change": {
      "type": "string",
      "pattern": "^[A-Za-z0-9]+(?:[._-][A-Za-z0-9]+)*$"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "outcome": {
      "enum": ["pass", "partial", "blocked"]
    },
    "tasks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/task"
      }
    },
    "incidents": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/incident"
      }
    },
    "learnings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/learning"
      }
    }
  },
  "$defs": {
    "key": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
    },
    "evidenceRefs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "oneOf": [
          {"type": "string", "pattern": "^file:.+$"},
          {"type": "string", "pattern": "^commit:([0-9a-fA-F]{40}|[0-9a-fA-F]{64})$"},
          {"type": "string", "pattern": "^task:.+$"},
          {"type": "string", "pattern": "^incident:.+$"}
        ]
      }
    },
    "externalEvidenceRefs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "oneOf": [
          {"type": "string", "pattern": "^file:.+$"},
          {"type": "string", "pattern": "^commit:([0-9a-fA-F]{40}|[0-9a-fA-F]{64})$"}
        ]
      }
    },
    "incidentEvidenceRefs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "oneOf": [
          {"type": "string", "pattern": "^file:.+$"},
          {"type": "string", "pattern": "^commit:([0-9a-fA-F]{40}|[0-9a-fA-F]{64})$"},
          {"type": "string", "pattern": "^task:.+$"}
        ]
      }
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "grade", "evidence", "evidence_refs"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9]+(?:[._-][A-Za-z0-9]+)*$"
        },
        "grade": {
          "enum": ["pass", "fail", "unobserved", "blocked"]
        },
        "evidence": {
          "type": "string",
          "minLength": 1
        },
        "evidence_refs": {
          "$ref": "#/$defs/externalEvidenceRefs"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "grade": {"enum": ["pass", "fail"]}
            }
          },
          "then": {
            "properties": {
              "evidence_refs": {"minItems": 1}
            }
          }
        }
      ]
    },
    "incident": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "kind",
        "status",
        "symptom",
        "hypothesis",
        "proposed_fix",
        "verification_plan",
        "evidence_refs"
      ],
      "properties": {
        "key": {
          "$ref": "#/$defs/key"
        },
        "kind": {
          "enum": [
            "defect",
            "conflict",
            "retry",
            "resource_denial",
            "stale_process",
            "crash_recovery"
          ]
        },
        "status": {
          "enum": ["open", "verified", "rejected", "inconclusive"]
        },
        "symptom": {
          "type": "string",
          "minLength": 1
        },
        "hypothesis": {
          "type": "string",
          "minLength": 1
        },
        "proposed_fix": {
          "type": "string",
          "minLength": 1
        },
        "verification_plan": {
          "type": "string",
          "minLength": 1
        },
        "evidence_refs": {
          "$ref": "#/$defs/incidentEvidenceRefs"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {"enum": ["verified", "rejected"]}
            }
          },
          "then": {
            "properties": {
              "evidence_refs": {"minItems": 1}
            }
          }
        }
      ]
    },
    "learning": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "kind",
        "scopes",
        "rule",
        "evidence",
        "evidence_refs"
      ],
      "properties": {
        "key": {
          "$ref": "#/$defs/key"
        },
        "kind": {
          "enum": ["rule", "gate_candidate"]
        },
        "scopes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
          }
        },
        "rule": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "string",
          "minLength": 1
        },
        "evidence_refs": {
          "allOf": [
            {"$ref": "#/$defs/evidenceRefs"},
            {"minItems": 1}
          ]
        },
        "supersedes": {
          "type": "array",
          "default": [],
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/key"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {"const": "gate_candidate"}
            }
          },
          "then": {
            "properties": {
              "supersedes": {"maxItems": 0}
            }
          }
        }
      ]
    }
  }
}
