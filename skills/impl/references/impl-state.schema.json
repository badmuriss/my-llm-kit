{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/badmuriss/my-llm-kit/schemas/impl-state.json",
  "title": "Active impl state",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "change",
    "run_id",
    "status",
    "outcome",
    "started_at",
    "updated_at",
    "base_commit",
    "last_observed_commit",
    "tasks",
    "cleanup",
    "digest"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "change": {
      "type": "string",
      "pattern": "^[A-Za-z0-9]+(?:[._-][A-Za-z0-9]+)*$"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9]+(?:[._-][A-Za-z0-9]+)*$"
    },
    "status": {"enum": ["active", "complete"]},
    "outcome": {
      "type": ["string", "null"],
      "enum": ["pass", "partial", "blocked", null]
    },
    "started_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"},
    "base_commit": {"type": "string", "minLength": 1},
    "last_observed_commit": {"type": "string", "minLength": 1},
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "text",
          "status",
          "worker",
          "hypotheses",
          "evidence_refs",
          "note"
        ],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "text": {"type": "string", "minLength": 1},
          "status": {
            "enum": [
              "pending",
              "running",
              "interrupted",
              "pass",
              "fail",
              "unobserved",
              "blocked"
            ]
          },
          "worker": {"type": ["string", "null"]},
          "hypotheses": {
            "type": "array",
            "maxItems": 2,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "evidence_refs": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "oneOf": [
                {"type": "string", "pattern": "^file:.+$"},
                {"type": "string", "pattern": "^commit:([0-9a-fA-F]{40}|[0-9a-fA-F]{64})$"}
              ]
            }
          },
          "note": {"type": "string"}
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {"const": "running"}
              }
            },
            "then": {
              "properties": {
                "worker": {"type": "string", "minLength": 1}
              }
            }
          },
          {
            "if": {
              "properties": {
                "status": {"enum": ["pass", "fail"]}
              }
            },
            "then": {
              "properties": {
                "evidence_refs": {"minItems": 1}
              }
            }
          },
          {
            "if": {
              "properties": {
                "status": {"enum": ["pass", "fail", "unobserved", "blocked"]}
              }
            },
            "then": {
              "properties": {
                "note": {"minLength": 1}
              }
            }
          }
        ]
      }
    },
    "cleanup": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "target", "owner", "status"],
        "properties": {
          "kind": {
            "enum": ["process", "worktree", "branch", "temp_path", "other"]
          },
          "target": {"type": "string", "minLength": 1},
          "owner": {"type": "string", "minLength": 1},
          "status": {"enum": ["pending", "done"]}
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "kind": {"const": "process"}
              }
            },
            "then": {
              "properties": {
                "target": {"pattern": "^[0-9]+$"}
              }
            }
          }
        ]
      }
    },
    "digest": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {"const": "active"}
        }
      },
      "then": {
        "properties": {
          "outcome": {"const": null}
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {"const": "complete"}
        }
      },
      "then": {
        "properties": {
          "outcome": {"enum": ["pass", "partial", "blocked"]}
        }
      }
    }
  ]
}
