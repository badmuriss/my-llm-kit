{
  "schema_version": 1,
  "policy_id": "portable-routing-v1",
  "metadata": {
    "source": "Portable abstract routing defaults; concrete choices come from the active host configuration and catalog.",
    "default_refresh_interval_days": 14,
    "early_refresh_reasons": ["provider_removal", "catalog_incompatibility", "known_price_or_quota_change", "route_failure", "owner_request"]
  },
  "role_defaults": {
    "coordinator": {"lane": "balanced", "effort": "medium"},
    "research": {"lane": "fast", "effort": "low"},
    "documentation": {"lane": "fast", "effort": "low"},
    "implementation": {"lane": "fast", "effort": "medium"},
    "review": {"lane": "balanced", "effort": "medium"},
    "verification": {"lane": "fast", "effort": "low"},
    "integration": {"lane": "balanced", "effort": "medium"}
  },
  "risk_minimums": {
    "routine": {"lane": "fast", "effort": "low"},
    "material": {"lane": "balanced", "effort": "medium"},
    "high": {"lane": "strong", "effort": "medium"}
  },
  "check_minimums": {
    "decisive": {"lane": "fast", "effort": "low"},
    "partial": {"lane": "fast", "effort": "medium"},
    "none": {"lane": "balanced", "effort": "medium"}
  },
  "tool_minimums": {"browser": {"lane": "balanced", "effort": "medium"}},
  "context_bands": [
    {"min_tokens": 0, "lane": "fast", "effort": "low"},
    {"min_tokens": 64000, "lane": "balanced", "effort": "medium"}
  ],
  "candidate_order": []
}
