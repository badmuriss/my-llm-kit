    {"provider": "openai", "agent": "codex", "model": "gpt-5.6-sol", "effort": "high"},
    {"provider": "openai", "agent": "codex", "model": "gpt-5.6-sol", "effort": "xhigh"},
    {"provider": "openai", "agent": "codex", "model": "gpt-6-astra", "effort": "high"},
    {"provider": "openai", "agent": "codex", "model": "gpt-6-astra", "effort": "xhigh"}
