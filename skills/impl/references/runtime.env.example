# Copy these values into .env at the project root. Keep .env out of git.
IMPL_OS=windows
IMPL_PROJECT_DIR=C:\Users\your-name\Projects\your-project

# macOS example:
# IMPL_OS=macos
# IMPL_PROJECT_DIR=/Users/your-name/Projects/your-project

# Linux example:
# IMPL_OS=linux
# IMPL_PROJECT_DIR=/home/your-name/Projects/your-project
