{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/badmuriss/my-llm-kit/schemas/maestro-capability-receipt-v1.json",
  "title": "Maestro compatibility capability receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "producer", "task_id", "capability", "grade", "check", "import", "evidence"],
  "properties": {"schema_version": {"const": 1}, "producer": {"$ref": "#/$defs/producer"}, "task_id": {"type": "string", "pattern": "^MLK-[0-9]+[A-Z]*$"}, "capability": {"$ref": "#/$defs/capability"}, "grade": {"const": "pass"}, "check": {"$ref": "#/$defs/check"}, "import": {"oneOf": [{"$ref": "#/$defs/import"}, {"type": "null"}]}, "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidence"}}, "required_producers": {"oneOf": [{"$ref": "#/$defs/quarantineProducers"}, {"$ref": "#/$defs/graphProgressProducers"}]}, "routing_policy": {"$ref": "#/$defs/routingPolicy"}},
  "oneOf": [
    {"properties": {"capability": {"properties": {"name": {"const": "result-quarantine"}}}, "required_producers": {"$ref": "#/$defs/quarantineProducers"}}, "required": ["required_producers"], "not": {"required": ["routing_policy"]}},
    {"properties": {"capability": {"properties": {"name": {"const": "run-progress"}}}, "required_producers": {"$ref": "#/$defs/graphProgressProducers"}}, "required": ["required_producers"], "not": {"required": ["routing_policy"]}},
    {"properties": {"capability": {"properties": {"name": {"const": "routing-policy"}}}}, "required": ["routing_policy"], "not": {"required": ["required_producers"]}},
    {"properties": {"capability": {"properties": {"name": {"enum": ["workspace-binding", "selected-placement-recovery", "typed-cleanup-lifecycle", "persisted-driver-context", "maestro-bridge"]}}}}, "not": {"anyOf": [{"required": ["required_producers"]}, {"required": ["routing_policy"]}]}}
  ],
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "evidence": {"type": "object", "additionalProperties": false, "required": ["ref", "digest"], "properties": {"ref": {"type": "string", "pattern": "^file:.+"}, "digest": {"$ref": "#/$defs/digest"}}},
    "workspace": {"type": "object", "additionalProperties": false, "required": ["execution_host_id", "kind", "path", "workspace_key"], "properties": {"execution_host_id": {"type": "string", "minLength": 1}, "kind": {"type": "string", "minLength": 1}, "path": {"type": "string", "minLength": 1}, "workspace_key": {"type": "string", "minLength": 1}}},
    "workspaceScope": {"type": "object", "additionalProperties": false, "required": ["schema_version", "repository_id", "run_id", "base_revision", "binding_receipt_ref", "binding_receipt_hash", "canonical_root", "coordinator_generation", "dirty_paths", "execution_host", "execution_workspace", "orchestration_home"], "properties": {"schema_version": {"const": 1}, "repository_id": {"type": "string", "minLength": 1}, "run_id": {"type": "string", "minLength": 1}, "base_revision": {"type": "string", "minLength": 1}, "binding_receipt_ref": {"type": "string", "minLength": 1}, "binding_receipt_hash": {"$ref": "#/$defs/digest"}, "canonical_root": {"type": "string", "minLength": 1}, "coordinator_generation": {"type": "integer", "minimum": 1}, "dirty_paths": {"type": "array", "items": {"type": "string"}}, "execution_host": {"type": "object", "additionalProperties": false, "required": ["boundary", "id"], "properties": {"boundary": {"type": "string", "minLength": 1}, "id": {"type": "string", "minLength": 1}}}, "execution_workspace": {"$ref": "#/$defs/workspace"}, "orchestration_home": {"$ref": "#/$defs/workspace"}}},
    "producer": {"type": "object", "additionalProperties": false, "required": ["run_id", "change", "journal_digest", "state_digest", "control_runtime", "workspace_scope"], "properties": {"run_id": {"type": "string", "minLength": 1}, "change": {"type": "string", "minLength": 1}, "journal_digest": {"$ref": "#/$defs/digest"}, "state_digest": {"$ref": "#/$defs/digest"}, "control_runtime": {"type": "object", "additionalProperties": false, "required": ["reference_digest", "directory_digest", "source_revision"], "properties": {"reference_digest": {"$ref": "#/$defs/digest"}, "directory_digest": {"$ref": "#/$defs/digest"}, "source_revision": {"type": "string", "minLength": 1}}}, "workspace_scope": {"$ref": "#/$defs/workspaceScope"}}},
    "capability": {"type": "object", "additionalProperties": false, "required": ["name", "version"], "properties": {"name": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"}, "version": {"type": "integer", "minimum": 1}}},
    "checkExecution": {"type": "object", "additionalProperties": false, "required": ["execution_id", "command_digest", "source_snapshot_digest"], "properties": {"execution_id": {"type": "string", "minLength": 1}, "command_digest": {"$ref": "#/$defs/digest"}, "source_snapshot_digest": {"$ref": "#/$defs/digest"}}},
    "check": {"type": "object", "additionalProperties": false, "required": ["authority", "command", "evidence", "execution"], "properties": {"authority": {"enum": ["checked_import", "check_recorded"]}, "command": {"type": "string", "minLength": 1}, "evidence": {"$ref": "#/$defs/evidence"}, "execution": {"oneOf": [{"$ref": "#/$defs/checkExecution"}, {"type": "null"}]}}},
    "import": {"type": "object", "additionalProperties": false, "required": ["import_id", "evidence"], "properties": {"import_id": {"type": "string", "minLength": 1}, "evidence": {"$ref": "#/$defs/evidence"}}},
    "producerTask": {"type": "object", "additionalProperties": false, "required": ["task_id", "grade", "check", "import", "evidence"], "properties": {"task_id": {"type": "string", "pattern": "^MLK-[0-9]+[A-Z]*$"}, "grade": {"const": "pass"}, "check": {"$ref": "#/$defs/check"}, "import": {"oneOf": [{"$ref": "#/$defs/import"}, {"type": "null"}]}, "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}}}},
    "quarantineProducers": {"type": "array", "minItems": 3, "maxItems": 3, "prefixItems": [{"allOf": [{"$ref": "#/$defs/producerTask"}, {"properties": {"task_id": {"const": "MLK-06Q"}}}]}, {"allOf": [{"$ref": "#/$defs/producerTask"}, {"properties": {"task_id": {"const": "MLK-06QR"}}}]}, {"allOf": [{"$ref": "#/$defs/producerTask"}, {"properties": {"task_id": {"const": "MLK-15"}}}]}], "items": false},
    "graphProgressProducers": {"type": "array", "minItems": 3, "maxItems": 3, "prefixItems": [{"allOf": [{"$ref": "#/$defs/producerTask"}, {"properties": {"task_id": {"const": "MLK-07"}}}]}, {"allOf": [{"$ref": "#/$defs/producerTask"}, {"properties": {"task_id": {"const": "MLK-07P"}}}]}, {"allOf": [{"$ref": "#/$defs/producerTask"}, {"properties": {"task_id": {"const": "MLK-19"}}}]}], "items": false},
    "routingPolicy": {"type": "object", "additionalProperties": false, "required": ["policy_id", "path", "digest", "evidence"], "properties": {"policy_id": {"type": "string", "minLength": 1}, "path": {"type": "string", "pattern": "^openspec/runs/[A-Za-z0-9._-]+/[A-Za-z0-9._-]+/artifacts/routing-policy-v1\\.json$"}, "digest": {"$ref": "#/$defs/digest"}, "evidence": {"$ref": "#/$defs/evidence"}}}
  }
}
